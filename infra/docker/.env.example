# Variaveis de ambiente do compose. Copiar pra .env e preencher.
# .env eh ignorado pelo git (verificar .gitignore).

# ── Azure Key Vault (CONFIG_PATH gateway.yaml usa ${kv:...}) ─────────────────
# URI do vault que tem os 4 secrets do boot:
#   - AZURE-OPENAI-API-KEY
#   - AZURE-LANGUAGE-API-KEY   (opcional, Tier 2/3 PII)
#   - AzureAIGateway-DB-Password-hom
#   - DB-ENCRYPTION-KEY        (64-char hex, AES-256-GCM)
KEYVAULT_URI=https://danieldev.vault.azure.net/

# ── Azure Auth ──────────────────────────────────────────────────────────────
# Use UMA das opcoes abaixo:
#
# Opcao A — Managed Identity (recomendada se rodando em VM Azure):
#   Nenhuma var necessaria. SDK detecta automatico.
#
# Opcao B — Service Principal (host nao-Azure):
#   Criar SP no portal/CLI e dar acesso "Key Vault Secrets User" no vault.
# AZURE_CLIENT_ID=
# AZURE_TENANT_ID=c050c98c-b463-4591-ac3b-deb782c0ba6e
# AZURE_CLIENT_SECRET=

# ── Endpoints Azure ─────────────────────────────────────────────────────────
AZURE_OPENAI_ENDPOINT=https://danie-mc4ryviy-westeurope.cognitiveservices.azure.com
AZURE_LANGUAGE_ENDPOINT=

# ── SQL Server (admin-api .NET; gateway Go le do gateway.yaml ${kv:...}) ────
# Padrao Microsoft.Data.SqlClient. Encrypt=true OBRIGATORIO.
# Senha vem do KV (NUNCA hardcoded aqui). Pra resolver, usar script
# `az keyvault secret show --vault-name danieldev --name AzureAIGateway-DB-Password-hom -o tsv`
# pre-boot, ou estourar essa var via wrapper.
SQL_CONNECTION_STRING=Server=BRSPVPDEV003.tpb.corp;Database=AzureAI_Gateway_hom;User Id=usr_sist_AzureAI_Gateway_hom;Password=__FROM_KV__;Encrypt=true;TrustServerCertificate=false;Application Name=api-gateway-admin

# ── Comportamento ───────────────────────────────────────────────────────────
PROVIDER=azure
LOG_LEVEL=info
MIGRATIONS_AUTO_APPLY=true
DOTNET_ENVIRONMENT=Production

# ── Paths host ──────────────────────────────────────────────────────────────
# Em prod corp, certs ficam fora do repo. Default aponta pro repo so pra dev.
CERTS_DIR=/etc/api-gateway/certs
LOG_DIR=/var/log/api-gateway
# CONFIG_PATH dentro do container; geralmente nao precisa mexer.
CONFIG_PATH=/app/configs/gateway.yaml
# Override do yaml por ambiente (host-side mount). Comente pra usar embedded.
# GATEWAY_CONFIG_PATH=/etc/api-gateway/gateway.yaml
